{
  "$schema": "https://tauri.app/v2/schema.json",
  "productName": "AI Master Desk",
  "version": "0.1.0",
  "identifier": "com.andreykozik.aimasterdesk",
  "build": {
    "beforeDevCommand": "yarn --cwd ui dev",
    "beforeBuildCommand": "yarn --cwd ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Master Desk",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
